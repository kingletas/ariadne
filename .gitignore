# ~/.gitignore is core.excludesFile for every repository under $HOME and it
# excludes *.sh, so without this negation a clone ships no build scripts at all
# -- silently, with no warning at commit and no sign until CI cannot find them.
# Unscoped on purpose: scoping it to one directory is how the next one gets
# missed.
!**/*.sh

# The same file also excludes `tools/*`, which swallowed this repository's
# corpus pipeline whole -- six files, silently, with a clean `git status`.
# `tests/test_repository.py` is what stops the next pattern doing it again.
!tools/**

__pycache__/
*.py[cod]
.venv/
.ruff_cache/
.pytest_cache/
dist/

# Disposable output, and the one place it is allowed to be. `~/.gitignore`
# excludes `**/local.d/**` for every repository here, so nothing under it can
# reach a commit even by accident -- which is the point of having one name for
# it rather than a new ignore line per kind of artefact.
local.d/

# `make smoke` photographs every view on every run into local.d/smoke. The
# screenshots the README shows are curated and live in docs/images/.
build/
.flatpak-builder/
repo/
*.egg-info/
