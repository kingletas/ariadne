root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{md,yml,yaml,json,toml}]
indent_size = 2

[*.tsv]
# A tab is the field separator here, not indentation.
indent_style = tab
trim_trailing_whitespace = false

# The baselines and the fixtures are byte-exact on purpose: the golden models
# are lifted verbatim out of pages the renderer must still reproduce, and the
# ingest fixtures have their hashes recorded in tests/golden/ingest.tsv. An
# editor adding a final newline to one of these breaks a baseline silently.
[tests/golden/**]
insert_final_newline = false
trim_trailing_whitespace = false

[tests/fixtures/**]
insert_final_newline = false
trim_trailing_whitespace = false

[src/ariadne/data/*.json]
insert_final_newline = false
