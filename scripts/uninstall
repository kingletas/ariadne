#!/usr/bin/env bash
#
# Removes what `scripts/install` put on the system. Never touches the source,
# and never touches a ruling: the reader's decisions are theirs.
#
# It refreshes the same two caches the installer writes. Removing the icon and
# leaving the cache that names it is worse than leaving both: a user icon
# directory outranks /usr/share, so a cache there claiming an icon that is gone
# hides the packaged one, and the application runs with no icon at all. That
# happened, and it took an afternoon to find because everything else was right.

set -euo pipefail

prefix="${1:-$HOME/bin}"
app_id="com.kingletas.Ariadne"

for path in \
	"$prefix/ariadne" \
	"$HOME/.local/share/applications/$app_id.desktop" \
	"$HOME/.local/share/icons/hicolor/scalable/apps/$app_id.svg" \
	"$HOME/.local/share/metainfo/$app_id.metainfo.xml"
do
	if [ -e "$path" ]; then
		rm -f "$path"
		echo "removed $path"
	fi
done

if command -v update-desktop-database > /dev/null; then
	update-desktop-database -q "$HOME/.local/share/applications" || true
fi
if command -v gtk-update-icon-cache > /dev/null; then
	gtk-update-icon-cache -qtf "$HOME/.local/share/icons/hicolor" 2> /dev/null || true
fi
